# Monitoring Stack — пример переменных окружения
# Скопируйте в .env при необходимости: cp .env.example .env

# Backend (локальная разработка и prisma generate)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitoring
# For low-memory environments: ?connection_limit=3&pool_timeout=10

# Backend (docker-compose)
JWT_SECRET=change-me-in-production
AUTH_ENABLED=false
# Set AUTH_ENABLED=true for production; then log in at /login (seed user: demo@test.com / demo)
AGENT_COMMAND_SECRET=dev-secret

# TUI (Node)
API_URL=http://localhost:3000
TUI_REFRESH_MS=5000
TUI_ALERTS_REFRESH_MS=10000
TUI_THEME=dark
TUI_PROCESS_LIMIT=200

# localterm
LOCALTERM_DELAY=1000
