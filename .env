# Backend
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monitoring
JWT_SECRET=your-secret-key-min-32-chars
PASSWORD_SALT=random-salt-for-passwords

# Web (build-time)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Agent (use in /etc/monagent/config.yaml or env)
# MONAGENT_SERVER_URL=http://localhost:3000
# MONAGENT_HOST_ID=<uuid-from-backend>
# MONAGENT_HOST_TOKEN=<token-from-backend>
